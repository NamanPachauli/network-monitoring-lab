
{
  "uid": "network-overview",
  "title": "Network Monitoring Overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Endpoint Reachable",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "probe_success{job=\"blackbox\"}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Probe Duration",
      "gridPos": {"x": 8, "y": 0, "w": 16, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "probe_duration_seconds{job=\"blackbox\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Probe Success",
      "gridPos": {"x": 0, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "probe_success{job=\"blackbox\"}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Status Code",
      "gridPos": {"x": 8, "y": 8, "w": 16, "h": 5},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "probe_http_status_code{job=\"blackbox\"}", "refId": "A"}
      ]
    }
  ]
}
